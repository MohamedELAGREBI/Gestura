<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Gestura.Converters"
             xmlns:components="clr-namespace:Gestura.Components"
             x:Class="Gestura.Views.ImageGalleryPage"
             Title="Image Gallery">

    <Grid RowDefinitions="Auto, Auto, *" Padding="10">
        <!-- Barre de recherche -->
        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher ..."
                   Text="{Binding SearchText, Mode=TwoWay}" />

        <!-- Bouton d'importation -->
        <Button Grid.Row="1"
                Text="Importer une image"
                Command="{Binding OpenImportPopupCommand}" />

        <!-- CollectionView avec défilement -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredDirectories}"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <components:DirectoryComponent Directory="{Binding}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>